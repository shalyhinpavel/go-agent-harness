# Copy to .env and fill in one key: the harness command picks the provider
# from the first key it finds (Anthropic, OpenAI, OpenRouter).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=

# A local or self-hosted OpenAI-compatible server (Ollama, vLLM, LM Studio)
# instead: its base URL and model.
# OPENAI_BASE_URL=http://localhost:11434/v1
# AGENT_MODEL=qwen3

# Optional overrides: provider kind (auto | anthropic | openai | openai-compat
# | openrouter | mock), model id, HTTP port for "harness serve".
# AGENT_PROVIDER=auto
# AGENT_MODEL=
# PORT=8080
